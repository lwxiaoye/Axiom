# Copy to deploy/local/.env. Used only by docker compose interpolation.
# Never commit the copied file.

AXIOM_DB_PASSWORD=CHANGE_ME
AXIOM_CONNECTOR_SECRET=CHANGE_ME

# Local administrator: no built-in password; at least 12 characters.
AXIOM_ADMIN_USER=admin
AXIOM_ADMIN_PASSWORD=CHANGE_ME
# Explicit local demo mode; prefilled values are public in the browser bundle.
AXIOM_LOCAL_DEMO_LOGIN=false
AXIOM_LOCAL_DEMO_USERNAME=
AXIOM_LOCAL_DEMO_PASSWORD=
# Public AES protocol parameters, also configured in the Vue frontend.
AXIOM_LOGIN_AES_KEY=AxiomCampusKey16
AXIOM_LOGIN_AES_IV=AxiomCampusIv16!
AXIOM_CORS_ORIGINS=http://127.0.0.1:3200,http://localhost:3200
# OpenAI-compatible model endpoint (local gateway OR a cloud provider).
# This Compose stack does not deploy model weights or a model gateway.
AXIOM_MODEL_BASE_URL=http://host.docker.internal:3001/v1
