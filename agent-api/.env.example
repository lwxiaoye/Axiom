# Copy to agent-api/.env. Supply new credentials; never reuse archived credentials.
PROJECT_NAME=AXIOM Agent API
DATABASE_URL=mysql+aiomysql://axiom:CHANGE_ME@127.0.0.1:3306/ai_boot?charset=utf8mb4
CHECKPOINT_DATABASE_URL=postgresql://axiom:CHANGE_ME@127.0.0.1:5432/langgraph_checkpoints
RUNTIME_DATABASE_URL=postgresql+psycopg://axiom:CHANGE_ME@127.0.0.1:5432/agent_runtime
JAVA_INTERNAL_BASE=http://127.0.0.1:9090
AUTH_TOKEN_CACHE_TTL_SECONDS=0
NEWAPI_BASE_URL=http://127.0.0.1:3001/v1
QDRANT_URL=http://127.0.0.1:6333
RUNTIME_REQUIRED=true
MIGRATE_ON_STARTUP=false
INTERNAL_SYNC_SECRET=
GATEWAY_IDENTITY_SECRET=
GATEWAY_IDENTITY_SIGNATURE_REQUIRED=true
FILE_STORAGE_PROVIDER=local
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Optional capabilities: configure only when your own services are available.
SKILL_SANDBOX_PROVIDER=opensandbox
SKILL_SANDBOX_OPENSANDBOX_DOMAIN=
SKILL_SANDBOX_OPENSANDBOX_API_KEY=
BROWSER_SERVICE_URL=
CONNECTOR_SECRET_KEY=
CONNECTOR_GITHUB_CLIENT_ID=
CONNECTOR_GITHUB_CLIENT_SECRET=
CONNECTOR_GOOGLE_CLIENT_ID=
CONNECTOR_GOOGLE_CLIENT_SECRET=
# Model credentials and campus knowledge bindings are configured through the platform.
# The campus assistant needs an available search service if official-web lookup is enabled.
