VITE_PUBLIC_PATH=/
VITE_PROXY=[["/api","http://127.0.0.1:9090/"],["/upload","http://127.0.0.1:9090/upload"],["/agent-api","http://127.0.0.1:8000/agent-api"]]
# 与生产一致走同源 /api（Vite dev server 代理到 auth-api）。写 127.0.0.1:9090 只有浏览器
# 就在服务器本机时才通，远程访问 dev 站点时头像/图标上传全部 ERR_CONNECTION_REFUSED。
VITE_GLOB_DOMAIN_URL=/api
VITE_GLOB_API_URL=/api
VITE_GLOB_API_URL_PREFIX=
VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps
VITE_LOGIN_AES_KEY=AxiomCampusKey16
VITE_LOGIN_AES_IV=AxiomCampusIv16!
VITE_REQUEST_SIGNATURE_SALT=AxiomSignSalt
