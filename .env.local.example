# Copy to .env.development.local and replace endpoints with your own services.
VITE_PROXY=[["/api","http://127.0.0.1:9090/"],["/upload","http://127.0.0.1:9090/upload"],["/agent-api","http://127.0.0.1:8000/agent-api"]]
# Optional legacy Java BPMN classes; configure their actual fully qualified names.
VITE_BPMN_TASK_LISTENER_CLASS=
VITE_BPMN_SEND_DELEGATE_CLASS=
# Public compatibility salt expected by the Java signature protocol, not a secret.
VITE_REQUEST_SIGNATURE_SALT=
# Public AES compatibility parameters: key 16/24/32 bytes, IV 16 bytes.
# They must match your Java backend. They are not server-side secrets.
VITE_LOGIN_AES_KEY=
VITE_LOGIN_AES_IV=
